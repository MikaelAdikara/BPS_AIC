# Deciqo - contoh environment variables
# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit .env asli.
# Referensi: blueprint bagian 30.3 (detail operasional docker) dan 27.2 (config backend).

# --- Mode operasi (bagian 30.2) ---
# full     = orchestrator LLM aktif, narasi disusun LLM
# fallback = paksa FALLBACK MODE, narasi memakai template deterministic
MODE=full

# --- Path & cache model (bagian 30.3) ---
MODEL_CACHE_DIR=/app/models
CONFIG_PATH=/app/configs/config.yaml

# --- Batas request (bagian 27.2, 36) ---
MAX_UPLOAD_MB=10
MAX_IMAGE_MB=5
MAX_REVIEWS_PER_REQUEST=1000
ANALYZE_TIMEOUT_SECONDS=30
QNA_TIMEOUT_SECONDS=8

# --- OCR tangkapan layar (ING-10) ---
# Bahasa yang diminta ke Tesseract. Kalau salah satunya tidak terpasang, sistem TURUN ke
# bahasa yang tersedia dan mencatat peringatannya - bukan gagal total.
OCR_LANG=ind+eng
# Batas gambar per permintaan. Tesseract berjalan sinkron di proses yang sama dengan endpoint
# lain, jadi batch besar menahan permintaan analisis pengguna lain.
MAX_IMAGES_PER_REQUEST=10
# Hanya untuk mesin pengembang Windows: di dalam container biner-nya sudah ada di PATH.
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   TESSDATA_PREFIX=C:\Users\<anda>\AppData\Local\tessdata

# --- Threshold model visual (bagian 19.2) ---
# Nilai final ditetapkan dari distribusi skor sampel validasi pada Fase 3,
# BUKAN angka default. Nilai di bawah hanya placeholder sebelum kalibrasi.
THRESHOLD_VISUAL_CONFIDENCE=
THRESHOLD_VISUAL_MARGIN=

# --- Threshold retrieval (bagian 21.3) ---
# Di bawah ambang ini, sistem menjawab "data belum cukup" TANPA memanggil LLM.
RETRIEVAL_MIN_SIMILARITY=
RETRIEVAL_TOP_K=5

# --- Vector store (ADR-007) ---
# embedded = Chroma di dalam proses api (2 service)
# server   = Chroma sebagai service terpisah (3 service)
VECTOR_STORE_MODE=embedded
VECTOR_STORE_URL=http://vector-store:8000

# --- Ambang data kecil (bagian 22.2, 14.1) ---
MIN_REVIEWS_FOR_FULL_CONFIDENCE=15

# --- Logging (bagian 37.1) ---
# Log terstruktur JSON lines ke stdout, TANPA PII/teks ulasan mentah.
LOG_LEVEL=INFO

# ======================================================================================
# Deciqo
# Tanpa .env sama sekali aplikasi tetap jalan: mode aturan (tanpa AI) + akun demo.
# Rahasia (OPENAI_API_KEY, APIFY_TOKEN, TELEGRAM_BOT_TOKEN, key Woo nyata) hanya di .env.
# ======================================================================================

# --- Penyimpanan & akun ---
# Compose menyetel ini ke volume deciqo-data; di luar Docker default-nya tmp/deciqo.sqlite3.
DECIQO_DB_PATH=
DECIQO_DEMO_EMAIL=demo@deciqo.app
DECIQO_DEMO_PASSWORD=deciqo-demo
DECIQO_ALLOW_SIGNUP=true
# true bila disajikan lewat HTTPS
DECIQO_COOKIE_SECURE=false
DECIQO_PUBLIC_URL=http://localhost:3000

# --- AI (kosong = mode aturan) ---
OPENAI_API_KEY=
DECIQO_LLM_MODEL=gpt-5-mini
DECIQO_AI_BUDGET_USD=5
# Kuota bulanan per akun, 0 = mati
DECIQO_ACCOUNT_MONTHLY_AI_USD=0
# Harga per juta token; cek tarif resmi model yang dipakai
DECIQO_PRICE_INPUT_PER_M=0.25
DECIQO_PRICE_CACHED_INPUT_PER_M=0.025
DECIQO_PRICE_OUTPUT_PER_M=2.00

# --- Lazada lewat Apify (kosong = tombol fetch nonaktif, snapshot tetap bisa dimuat) ---
APIFY_TOKEN=
DECIQO_APIFY_BUDGET_USD=4

# --- WooCommerce (default: toko sintetis internal) ---
WOO_BASE_URL=http://woo-demo:8080
WOO_CONSUMER_KEY=ck_deciqo_demo_public
WOO_CONSUMER_SECRET=cs_deciqo_demo_public
WOO_DEMO_MODE=true
WOO_PAGE_SIZE=2
DECIQO_POLL_SECONDS=900

# --- Toko WooCommerce ASLI lokal (opsional): docker compose --profile store up -d --build ---
# Storefront http://localhost:8081, admin http://localhost:8081/wp-admin.
# Kredensial uji, hanya untuk toko demo lokal yang terikat ke 127.0.0.1. Kosong = nilai default ini.
# WOO_LOCAL_USER=deciqo                          # login admin WordPress
# WOO_LOCAL_ADMIN_PASSWORD=deciqo-demo-2026      # password admin WordPress
# WOO_LOCAL_API_PASSWORD=deciqoLocalStoreKey2026 # application password yang dipakai Deciqo
# WOO_LOCAL_URL=http://wordpress
# WOO_LOCAL_PUBLIC_URL=http://localhost:8081
# Rahasia HMAC webhook WooCommerce -> Deciqo (dipakai kedua sisi). Kosong = default demo lokal.
WOO_WEBHOOK_SECRET=

# --- Telegram (kosong = alert tercatat di log, status unconfigured) ---
TELEGRAM_BOT_TOKEN=
# Data sintetis dikirim ke sink simulasi, bukan ke chat nyata
TELEGRAM_DEMO_MODE=true
# Opsional: chat ID penerima alert AKUN DEMO saja, dipisah koma (mis. 123456789,987654321).
# Ketik /id ke bot untuk melihat chat ID. Akun lain tetap hanya ke chat yang ditautkan lewat kode.
TELEGRAM_CHAT_ID=
DECIQO_WEEKLY_DIGEST=false

# --- Runtime ---
DECIQO_JOB_WORKERS=3
# tfidf = start cepat; auto = memuat model embedding besar
EMBEDDING_MODE=tfidf
# Diisi saat build: APP_COMMIT=$(git rev-parse --short HEAD) docker compose build
APP_COMMIT=
