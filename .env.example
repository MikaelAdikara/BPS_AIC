# InsightUlasan - contoh environment variables
# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit .env asli.
# Referensi: blueprint bagian 30.3 (detail operasional docker) dan 27.2 (config backend).

# --- Mode operasi (bagian 30.2) ---
# full     = orchestrator LLM aktif, narasi disusun LLM
# fallback = paksa FALLBACK MODE, narasi memakai template deterministic
MODE=full

# --- Path & cache model (bagian 30.3) ---
MODEL_CACHE_DIR=/app/models
CONFIG_PATH=/app/configs/config.yaml

# --- Batas request (bagian 27.2, 36) ---
MAX_UPLOAD_MB=10
MAX_IMAGE_MB=5
MAX_REVIEWS_PER_REQUEST=1000
ANALYZE_TIMEOUT_SECONDS=30
QNA_TIMEOUT_SECONDS=8

# --- Threshold model visual (bagian 19.2) ---
# Nilai final ditetapkan dari distribusi skor sampel validasi pada Fase 3,
# BUKAN angka default. Nilai di bawah hanya placeholder sebelum kalibrasi.
THRESHOLD_VISUAL_CONFIDENCE=
THRESHOLD_VISUAL_MARGIN=

# --- Threshold retrieval (bagian 21.3) ---
# Di bawah ambang ini, sistem menjawab "data belum cukup" TANPA memanggil LLM.
RETRIEVAL_MIN_SIMILARITY=
RETRIEVAL_TOP_K=5

# --- Vector store (ADR-007) ---
# embedded = Chroma di dalam proses api (2 service)
# server   = Chroma sebagai service terpisah (3 service)
VECTOR_STORE_MODE=embedded
VECTOR_STORE_URL=http://vector-store:8000

# --- Ambang data kecil (bagian 22.2, 14.1) ---
MIN_REVIEWS_FOR_FULL_CONFIDENCE=15

# --- Logging (bagian 37.1) ---
# Log terstruktur JSON lines ke stdout, TANPA PII/teks ulasan mentah.
LOG_LEVEL=INFO
